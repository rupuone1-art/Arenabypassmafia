# Необязательные серверные провайдеры.
# Основной путь: ключ Yukino вставляется в интерфейсе (лобби → «API-ключ Yukino»).

# Резервная модель на сервере (если ключ Yukino не задан)
GEMINI_API_KEY=

# Ключ Yukino на весь сервер, вместо вставки в браузере
YUKINO_API_KEY=
YUKINO_BASE_URL=https://api.yukino.my

PORT=3000
