# ───────────────────────────────────────────────────────────────
# ИИ Мафия: Битва Интеллектов — конфигурация провайдеров
# Скопируйте в .env (или .env.local) и заполните нужные ключи.
# Без ключей игра всё равно работает — на локальном движке.
# ───────────────────────────────────────────────────────────────

# auto (по умолчанию) | gemini | yukino | local
# local — принудительно встроенный движок без сетевых вызовов
AI_PROVIDER=auto

# ── Google Gemini ──────────────────────────────────────────────
# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Yukino (OpenAI-совместимый шлюз) ───────────────────────────
# Ключ хранится ТОЛЬКО на сервере и никогда не попадает в браузер
YUKINO_API_KEY=
YUKINO_BASE_URL=https://api.yukino.my
YUKINO_MODEL=yukino-free

# ── Сервер ─────────────────────────────────────────────────────
PORT=3000
